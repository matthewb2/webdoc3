{
  "name": "DOC3",
  "private": true,
  "description": "Web-based Word Processor supporting HWP, DOCX, and ODT",
  "author": "MK-SOLUTION",
  "version": "0.1.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "tsc && vite build && npm run build:electron",
    "preview": "vite preview",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win"
  },
  "build": {
    "appId": "com.doc3.app",
    "productName": "DOC3",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "build/icon.ico",
      "build/icon-256.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "26.6.1",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@hwp.js/parser": "^0.0.4-alpha.0",
    "cfb": "1.2.2",
    "docx": "^9.8.1",
    "jszip": "^2.5.0",
    "pako": "1.0.11"
  }
}
